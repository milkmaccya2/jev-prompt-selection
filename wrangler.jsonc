{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-prompt-selection",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  // /api/select: at most 20 requests per minute per IP (both APIs are called on each request)
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
  // Secrets (never commit them): TYPESAFE_API_KEY and OPENAI_API_KEY, set with `npx wrangler secret put <NAME>`
}
