{
  "name": "jev-prompt-selection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "index": "tsx src/buildIndex.ts",
    "check:data": "tsx src/checkData.ts",
    "eval": "tsx --env-file-if-exists=.env src/eval.ts",
    "report": "tsx src/report.ts",
    "web": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "gpt-tokenizer": "^4.0.0",
    "gray-matter": "^4.0.3"
  }
}
