{
  "name": "jev-prompt-selection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "index": "tsx src/buildIndex.ts",
    "check:data": "tsx src/checkData.ts",
    "eval": "tsx --env-file-if-exists=.env src/eval.ts",
    "report": "tsx src/report.ts",
    "web": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "build:web": "tsx src/buildWebData.ts",
    "cf:dev": "npm run build:web && wrangler dev",
    "cf:deploy": "npm run build:web && wrangler deploy",
    "v2:label": "tsx --env-file-if-exists=.env src/v2/label.ts",
    "v2:agree": "tsx src/v2/agree.ts",
    "v2:eval": "tsx --env-file-if-exists=.env src/v2/eval.ts",
    "v2:report": "tsx src/v2/report.ts",
    "v3:label": "tsx --env-file-if-exists=.env src/v3/label.ts",
    "v3:eval": "tsx --env-file-if-exists=.env src/v3/eval.ts",
    "v3:frozen": "tsx src/v3/frozen.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "gpt-tokenizer": "^4.0.0",
    "gray-matter": "^4.0.3",
    "openai": "^7.27.0",
    "zod": "^4.6.5"
  }
}
